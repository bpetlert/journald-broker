# Maintainer: Bhanupong Petchlert <bpetlert@gmail.com>
pkgname=journald-broker
pkgver=0.7.0
pkgrel=1
pkgdesc="A log-based event dispatcher daemon for systemd's journal"
arch=('x86_64')
url="https://github.com/bpetlert/journald-broker"
license=('GPL-3.0-or-later')
depends=('systemd-libs')
makedepends=(cargo)
options=(!lto)
backup=(
    "etc/journald-broker.d/00-global-settings.conf"
    "etc/journald-broker.d/00-template.conf"
)

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/bpetlert/${pkgname}/archive/${pkgver}.tar.gz")
b2sums=('51053edf99dff5070f1b92fa4deed0238f56e9ceedb96a4db620b6c705fe30722cc65690a71682310a02a5fe69ac9ffba5abb6db061c22a1d97622455b9f3741')

prepare() {
    cd "${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target host-tuple
}

build() {
    cd "${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "${pkgname}-${pkgver}"
    install -vDm755 -t "${pkgdir}/usr/bin" target/release/journald-broker
    install -vDm644 -t "${pkgdir}/usr/lib/systemd/system" journald-broker.service
    install -vDm644 -t "${pkgdir}/usr/share/doc/${pkgname}" README.adoc
    install -vdm755 "${pkgdir}/etc/journald-broker.d/"
    install -vDm644 -t "${pkgdir}/etc/journald-broker.d" 00-global-settings.conf
    install -vDm644 -t "${pkgdir}/etc/journald-broker.d" 00-template.conf
}
