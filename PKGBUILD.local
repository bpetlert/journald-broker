# Maintainer: Bhanupong Petchlert <bpetlert@gmail.com>
pkgname=journald-broker
pkgver=0.7.0
pkgrel=1
pkgdesc="A log-based event dispatcher daemon for systemd's journal"
arch=('x86_64')
url="https://github.com/bpetlert/journald-broker"
license=('GPL-3.0-or-later')
depends=('systemd-libs')
makedepends=(cargo)
options=(!lto)
backup=(
    "etc/journald-broker.d/00-global-settings.conf"
    "etc/journald-broker.d/00-template.conf"
)

# Build from local directory
source=()

# Using the most recent annotated tag reachable from the last commit.
pkgver() {
    cd "${startdir}"
    git describe --long | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "${startdir}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target host-tuple
}

build() {
    cd "${startdir}"
    export RUSTUP_TOOLCHAIN=stable

    # Ignore target-dir in ~/.cargo/config, reset it to default: "target".
    # Add "${srcdir}" to support BUILDDIR variable in makepkg.
    export CARGO_TARGET_DIR=${srcdir}/target

    cargo build --frozen --release
}

package() {
    install -vDm755 -t "${pkgdir}/usr/bin" "${srcdir}/target/release/journald-broker"
    install -vDm644 -t "${pkgdir}/usr/lib/systemd/system" "${startdir}/journald-broker.service"
    install -vDm644 -t "${pkgdir}/usr/share/doc/${pkgname}" "${startdir}/README.adoc"
    install -vdm755 "${pkgdir}/etc/journald-broker.d/"
    install -vDm644 -t "${pkgdir}/etc/journald-broker.d" "${startdir}/00-global-settings.conf"
    install -vDm644 -t "${pkgdir}/etc/journald-broker.d" "${startdir}/00-template.conf"
}
